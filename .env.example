# Copy this file to .env.local (which is gitignored) and fill in your real
# values. NEVER commit real values. Restart `npm run dev` after changing
# anything here — these are read once, at startup.

# Your Supabase Project URL.
# Find it in: Supabase Dashboard -> Project Settings -> API.
# It looks like: https://abcdefgh.supabase.co
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co

# Your Supabase "anon" (a.k.a. "publishable") key — same place as above,
# Project Settings -> API. This key is SAFE in the browser: it can only do
# what your Row-Level-Security policies allow.
# NEVER put the service_role key here, or in any NEXT_PUBLIC_ variable —
# the service_role key bypasses RLS and must stay server-side only.
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# The name shown in the top bar, the sidebar, the login screen, and the
# browser tab title. Change it to your app's name. (Optional — defaults to "Web App".)
NEXT_PUBLIC_APP_NAME=My App
